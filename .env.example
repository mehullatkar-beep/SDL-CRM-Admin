AUTH_SECRET=
AUTH_TRUST_HOST=true

# Use pglite only for local development. Production requires DATABASE_URL.
DB_PROVIDER=pglite
DATABASE_URL=

# Vercel Blob (required in production)
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contract-first CrelioHealth gateway. Production requires provider=http.
LAB_MASTER_PROVIDER=mock
# LAB_MASTER_FAIL=true
# Crelio origin + /api-v3/masters/catalog  (client appends /tests)
LAB_MASTER_API_URL=
# Crelio INTERNAL_TOKEN, sent as X-Internal-Token
LAB_MASTER_API_TOKEN=
# Labs.publicKey for the SDL lab
LAB_MASTER_LAB_PUBLIC_KEY=
LAB_MASTER_TIMEOUT_MS=8000

NEXT_PUBLIC_CATALOG_CURRENCY=SAR
NEXT_PUBLIC_PATIENT_PORTAL_ORIGIN=http://localhost:3000
NEXT_PUBLIC_MOBILE_APP_ORIGIN=
ALLOWED_API_ORIGINS=http://localhost:3000

# One-time bootstrap only; do not retain the password after seeding.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# SEED_DEMO_USERS=true
